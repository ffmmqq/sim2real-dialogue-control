{
  "project_root": ".",
  "run_root": "runs",
  "analysis_root": "analysis",
  "experiment_name": "H1_MDP_Hybrid_AntiSpam_AugReward_local_llama",
  "learner_seeds": [1, 2, 3, 4, 5],
  "simulator_seed": 42,
  "simulator_seed_policy": "fixed for all training runs",
  "episodes": 500,
  "max_turns": 50,
  "state_dim": 151,
  "actions": 8,
  "simulator": "hybrid",
  "simulator_stochasticity": 0.5,
  "learning_rate": 0.0001,
  "gamma": 0.99,
  "llm_backend": "local_openai",
  "llm_model": "meta-llama/Llama-3.1-8B-Instruct",
  "agent_llm_temperature": 0.3,
  "agent_llm_max_tokens": 300,
  "simulator_llm_temperature": 0.6,
  "simulator_llm_max_tokens": 150,
  "local_llm_top_p": 0.9,
  "local_llm_base_url": "http://127.0.0.1:8000/v1",
  "local_llm_seed": 42,
  "checkpoint_interval": 10,
  "map_interval": 100,
  "default_device": "cpu",
  "reward": {
    "mode": "augmented",
    "centred_engagement": true,
    "broadened_novelty": true,
    "response_type_reward": true,
    "alpha_new": 1.0,
    "alpha_rep": 0.3,
    "alpha_clar": 0.3,
    "alpha_ask": 0.2,
    "alpha_stale": 1.0,
    "alpha_transition": 0.4,
    "action_repeat_penalty": 0.15,
    "action_repeat_threshold": 2,
    "w_responsiveness": 0.5,
    "w_conclude": 0.4,
    "w_response_type": 0.3
  }
}

